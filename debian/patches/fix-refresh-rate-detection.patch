+    @staticmethod
+    def _get_refresh_rate(mode):
+        """
+        Identifica a taxa de atualização (refresh rate) no objeto de modo do Mutter.
+        O refresh rate costuma ser > 20Hz, enquanto a escala costuma ser < 10.
+        """
+        try:
+            # Tenta o índice 3 (padrão em versões novas)
+            val3 = float(mode[3])
+            if val3 > 20.0:
+                return val3
+            
+            # Se o índice 3 for baixo (provavelmente uma escala), tenta o índice 4
+            if len(mode) > 4:
+                val4 = float(mode[4])
+                if val4 > 20.0:
+                    return val4
+            
+            return val3 # Fallback
+        except (Exception, IndexError):
+            return 60.0 # Último recurso
+
+
